@startuml
!include <C4/C4_Container>

title N2 - Contenedores sobre la red Docker saberpro-net (driver bridge)

Person(docente, "Docente", "Autor de reactivos.")

System_Boundary(red, "saberpro-net (bridge)") {
    Container(validation, "validation-service", "Java 17 / Spring Boot 3.4 / :8082", "Validacion estructural con Pipes and Filters (4 filtros).")
    Container(question, "question-service", "Java 17 / Spring Boot 3.4 / :8083", "Nucleo hexagonal: dominio puro, puertos y adaptadores.")
    Container(lifecycle, "lifecycle-service", "Java 17 / Spring Boot 3.4 / :8084", "Consumidor AMQP idempotente y patron State.")
    ContainerDb(postgres, "PostgreSQL 16", "postgres:16-alpine / :5432", "Esquema del agregado Question (perfil postgres).")
    ContainerDb(h2, "H2", "Base embebida", "Alternativa local y de pruebas (perfil h2).")
    ContainerQueue(rabbit, "rabbitmq", "rabbitmq:3.13-management / :5672 y :15672", "Exchange topic, cola de revision y DLQ.")
}

System_Ext(cliente, "Postman / Thunder Client", "Cliente de pruebas E2E.")

Rel(docente, cliente, "Dispara escenarios", "HTTPS")
Rel(cliente, question, "POST/GET /api/questions**", "REST/JSON")
Rel(cliente, lifecycle, "GET /api/lifecycle/questions/{id}", "REST/JSON")
Rel(cliente, rabbit, "Inspecciona topologia", "HTTP")
Rel(question, validation, "Valida antes de crear (ValidacionPreguntaPort)", "REST/JSON")
Rel(question, postgres, "Persiste via JpaQuestionAdapter", "JDBC")
Rel(question, h2, "Persiste via JpaQuestionAdapter (dev)", "JDBC")
Rel(question, rabbit, "Publica question.review.requested", "AMQP")
Rel(rabbit, lifecycle, "Entrega saberpro.lifecycle.question-review", "AMQP")
Rel(lifecycle, rabbit, "Nack hacia DLQ tras 3 reintentos", "AMQP")

SHOW_LEGEND()
@enduml
