              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('exchange topic durable', () => {",
                  "  pm.expect(body.name).to.eql('saberpro.questions.exchange');",
                  "  pm.expect(body.type).to.eql('topic');",
                  "  pm.expect(body.durable).to.be.true;",
