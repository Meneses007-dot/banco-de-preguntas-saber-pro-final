                  "pm.test('cola durable con consumidor', () => {",
                  "  pm.expect(body.name).to.eql('saberpro.lifecycle.question-review');",
                  "  pm.expect(body.durable).to.be.true;",
                  "  pm.expect(body.consumers).to.be.at.least(1);",
                  "});",
                  "pm.test('DLX configurado', () => {",
                  "  pm.expect(body.arguments['x-dead-letter-exchange']).to.eql('saberpro.questions.dlx');",
                  "});"
                ]
