            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{rabbitUser}}" },
                { "key": "password", "value": "{{rabbitPass}}" }
              ]
            },
            "url": "{{rabbitHost}}/api/exchanges/%2F/saberpro.questions.exchange"
          }
        },
        {
          "name": "E2E-07b Cola con consumer activo y DLX",
          "event": [
