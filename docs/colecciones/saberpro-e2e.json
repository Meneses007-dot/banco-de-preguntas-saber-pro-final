          "name": "E2E-00a Validacion estructural valida -> 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('valido=true y sin errores', () => {",
                  "  pm.expect(body.valido).to.be.true;",
                  "  pm.expect(body.errores).to.be.an('array').that.is.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{validationHost}}/api/validation/questions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"enunciado\": \"¿Cuál es la conclusión del autor del texto?\",\n  \"justificacion\": \"La clave se sustenta en la tesis central del tercer párrafo, donde el autor afirma su postura.\",\n  \"opciones\": [\n    { \"texto\": \"La conclusión del autor\", \"correcta\": true },\n    { \"texto\": \"Una cita textual\", \"correcta\": false },\n    { \"texto\": \"Un ejemplo del texto\", \"correcta\": false },\n    { \"texto\": \"Un dato histórico\", \"correcta\": false }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "E2E-00b Validacion estructural con 3 opciones -> 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "const body = pm.response.json();",
                  "pm.test('valido=false y errores reportados', () => {",
                  "  pm.expect(body.valido).to.be.false;",
                  "  pm.expect(body.errores.length).to.be.at.least(1);",
                  "});"
